{
  "name": "zenvorali-cleaning",
  "version": "1.0.0",
  "private": true,
  "description": "Zenvorali Cleaning - Premium residential & commercial cleaning services in Kansas City.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prepare:netlify": "node scripts/prepare-netlify.js",
    "images": "node scripts/generate-image-variants.js",
    "wordcount": "node scripts/wordcount.js",
    "audit:seo": "node scripts/check-seo.js",
    "verify:bundle": "node scripts/verify-netlify-bundle.js",
    "check": "npm run wordcount && npm run audit:seo",
    "build": "npm run prepare:netlify",
    "deploy": "netlify deploy --build --prod",
    "deploy:preview": "netlify deploy --build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "serverless-http": "^3.2.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "^1.3.4",
    "@img/sharp-win32-x64": "^0.35.5"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "netlify-cli": "^27.10.2",
    "sharp": "^0.33.4"
  }
}
